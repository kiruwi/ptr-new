{
  "name": "patamurestaurant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:security": "node --experimental-strip-types --test tests/**/*.test.ts",
    "security:sast": "node scripts/security-checks.mjs",
    "security:deps": "npm audit --audit-level=high",
    "ci:security": "npm run typecheck && npm run build && npm run test:security && npm run security:sast && npm run security:deps",
    "start": "node app.js",
    "package:cpanel": "node scripts/package-cpanel.mjs",
    "deploy:sftp": "node scripts/deploy-sftp.mjs"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "expo": "55.0.20",
    "gsap": "3.14.2",
    "lenis": "1.3.17",
    "nuxt": "4.3.1",
    "vue": "3.5.30",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.5"
  },
  "overrides": {
    "@unhead/vue": "2.1.13",
    "brace-expansion@^2.0.1": "2.0.3",
    "brace-expansion@^2.0.2": "2.0.3",
    "brace-expansion@^5.0.2": "5.0.5",
    "defu": "6.1.5",
    "devalue": "5.6.4",
    "h3": "1.15.9",
    "lodash": "4.18.0",
    "node-forge": "1.4.0",
    "picomatch@^2.0.4": "2.3.2",
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.2": "4.0.4",
    "picomatch@^4.0.3": "4.0.4",
    "serialize-javascript": "7.0.5",
    "srvx": "0.11.13",
    "unhead": "2.1.13",
    "vite": "7.3.2",
    "yaml": "2.8.3"
  }
}
