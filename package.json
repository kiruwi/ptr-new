{
  "name": "patamurestaurant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:security": "node --experimental-strip-types --test tests/**/*.test.ts",
    "security:sast": "node scripts/security-checks.mjs",
    "security:deps": "npm audit --audit-level=high",
    "ci:security": "npm run typecheck && npm run build && npm run test:security && npm run security:sast && npm run security:deps",
    "start": "node app.js",
    "package:cpanel": "node scripts/package-cpanel.mjs"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "gsap": "3.14.2",
    "lenis": "1.3.17",
    "nuxt": "4.3.1",
    "vue": "3.5.30",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.5"
  },
  "overrides": {
    "devalue": "5.6.4",
    "serialize-javascript": "7.0.4"
  }
}
